# ==============================================
# SecureCodeReviews.com — Environment Variables
# Copy this file to .env.local and fill in values
# ==============================================

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/scr?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=https://securecodereviews.com
NEXTAUTH_SECRET=your-random-secret-here-generate-with-openssl-rand-base64-32

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@securecodereviews.com
SMTP_PASSWORD=your-email-password

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (for monetization)
# Get your Publisher ID from https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXXX

# Google Search Console Verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Admin Credentials (for admin dashboard)
ADMIN_EMAIL=admin@securecodereviews.com
ADMIN_PASSWORD=change-this-to-a-strong-password
