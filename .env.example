# Copy this to .env.local and set real values (do NOT commit .env.local)
# NEVER use NEXT_PUBLIC_ prefix for secrets — they get shipped to every browser

MONGODB_URI=your-mongodb-connection-string
NEXTAUTH_SECRET=replace_with_secure_random
NEXTAUTH_URL=https://yourdomain.example
NODE_ENV=production

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASSWORD=change_me

ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change_me

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXX
NEXT_PUBLIC_SITE_URL=https://yourdomain.example

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_ENTERPRISE_PLAN_ID=
